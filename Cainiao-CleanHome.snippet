#!name = 菜鸟首页精简
#!desc = 隐藏首页搜索与快捷服务/营销入口，并只保留底部首页和我的；保留包裹列表。规则在圈 X 中生效，与菜鸟 App 本地缓存及重装无关。
#!author = Codex
#!update = 2026-09-16

# 使用历史版本的组件 ID 删除方式，不依赖 pageId 参数的编码形式。
# 2242=发现、2247=寄件券、2248=消息；operationList 为首页快捷入口，mainSearch 为搜索栏。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch url jsonjq-response-body 'del(.data.data.data.mainSearch, .data.data.data.operationList, .data.data["2242"], .data.data["2247"], .data.data["2248"])'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch url jsonjq-response-body 'del(.data.data.data.mainSearch, .data.data.data.operationList, .data.data["2242"], .data.data["2247"], .data.data["2248"])'

# 首页快捷服务、营销入口和“更多”由 NetFlow 广告位接口下发；拦截后包裹列表接口仍正常请求
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict

# 广告曝光回传（非展示必需，避免已隐藏入口继续产生回传请求）
^https:\/\/netflow-reply-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.ads\.expose\.mreply\.cn\/1\.0 url reject-dict

hostname = cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, netflow-mtop.cainiao.com, netflow-reply-mtop.cainiao.com
