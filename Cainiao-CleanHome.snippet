#!name = 菜鸟首页精简
#!desc = 隐藏首页搜索与快捷服务/营销入口，并只保留底部首页和我的；保留包裹列表。规则在圈 X 中生效，与菜鸟 App 本地缓存及重装无关。
#!author = Codex
#!update = 2026-09-16

# 首页页面布局：mainSearch 为搜索栏；operationList 包含“取包裹/寄包裹/清旧物/出库码”及下方快捷入口。
# 规则只会删除存在的字段，其他页面的布局响应不受影响。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0 url jsonjq-response-body 'del(.data.data.data.mainSearch, .data.data.data.operationList)'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0 url jsonjq-response-body 'del(.data.data.data.mainSearch, .data.data.data.operationList)'

# 底部导航布局：保留“首页”(2240) 和“我的”(2249)，移除中间三个 Tab。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1300 url jsonjq-response-body '.data.data |= with_entries(select(.key == "2240" or .key == "2249"))'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1300 url jsonjq-response-body '.data.data |= with_entries(select(.key == "2240" or .key == "2249"))'

# 首页快捷服务、营销入口和“更多”由 NetFlow 广告位接口下发；拦截后包裹列表接口仍正常请求
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict

# 广告曝光回传（非展示必需，避免已隐藏入口继续产生回传请求）
^https:\/\/netflow-reply-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.ads\.expose\.mreply\.cn\/1\.0 url reject-dict

hostname = cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, netflow-mtop.cainiao.com, netflow-reply-mtop.cainiao.com
