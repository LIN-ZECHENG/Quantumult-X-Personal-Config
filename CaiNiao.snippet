#!name = 菜鸟裹裹
#!author = ?
#!update = 2026-9-7

# ===== 1. 第三方广告 SDK 域名（直封） =====
host, sdk.1rtb.net, reject
host, adx-cfg-u1.ubixioe.com, reject
host, ssp.iytcdn.com, reject
host, cf-gl.qiezibenpao.com, reject
host, ipip-gl1.qiezibenpao.com, reject

# ===== 2. 菜鸟自研广告/推广/活动接口（直接置空响应） =====

# 菜鸟自研广告系统 nbnetflow
^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict

# 菜鸟 CPS / 京东淘宝等三方商品推广
^https:\/\/nbcps-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn.* url reject-dict

# 菜鸟直播 / 活动触发
^https:\/\/community-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguouser\.live\.activity\.trigger\.cn.* url reject-dict

# 运营 H5 页面（公益、任务等）
^https:\/\/page\.cainiao\.com\/mcn\/.* url reject-dict

# ===== 3. 移除"裹酱积分/包裹赚赚/欢乐赢红包/菜鸟回收/更多"组件 =====
# 该组件由 e2e 引擎 page.fetch 下发；pageId 常见 1100（首页）/1300/1400（功能区）
# 整段 reject 后这些动态卡片都会消失（如有其他必要卡片也走 e2e，再细化为 jsonjq 过滤）
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch.* url reject-dict

# ===== 4. 作用域：仅 MITM 这些域名（避免对全网抓包做处理） =====
hostname = netflow-mtop.cainiao.com, nbcps-mtop.cainiao.com, community-mtop.cainiao.com, e2e-mtop.cainiao.com, sdk.1rtb.net, adx-cfg-u1.ubixioe.com, ssp.iytcdn.com, cf-gl.qiezibenpao.com, ipip-gl1.qiezibenpao.com
