#!name = 菜鸟裹裹 v2
#!author = ?
#!update = 2026-9-7

# ============================================================
#  目标：移除首页红框功能组件
#    裹酱积分 / 包裹赚赚 / 欢乐赢红包 / 菜鸟回收 / 更多
#  下发接口：mtop.cainiao.app.e2e.engine.page.fetch
#  命中 pageId：1100（首页）
# ============================================================

# ===== 1. 第三方广告 SDK 域名（直封） =====
host, sdk.1rtb.net, reject
host, adx-cfg-u1.ubixioe.com, reject
host, ssp.iytcdn.com, reject
host, cf-gl.qiezibenpao.com, reject
host, ipip-gl1.qiezibenpao.com, reject

# ===== 2. 菜鸟自研广告/推广接口 =====
^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/nbcps-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn.* url reject-dict
^https:\/\/community-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguouser\.live\.activity\.trigger\.cn.* url reject-dict

# ===== 3. 精确移除首页第二行 icons 组件 =====
# 抓包确认：operationList[0].type=kingkong（取包裹/寄包裹/物换物/出库码），保留。
#          operationList[1].type=icons，items.key 为 gjjf/packageQa/sawPuzzle/cnhs/appCentreMore，移除。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1100 url jsonjq-response-body '.data.data.data.operationList |= map(if .type == "icons" then (.bizData.items |= map(select((.key // "") as $k | (["gjjf","packageQa","sawPuzzle","cnhs","appCentreMore"] | index($k) | not)))) else . end) | .data.data.data.operationList |= map(select((.type == "icons" and ((.bizData.items // []) | length == 0)) | not))'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1100 url jsonjq-response-body '.data.data.data.operationList |= map(if .type == "icons" then (.bizData.items |= map(select((.key // "") as $k | (["gjjf","packageQa","sawPuzzle","cnhs","appCentreMore"] | index($k) | not)))) else . end) | .data.data.data.operationList |= map(select((.type == "icons" and ((.bizData.items // []) | length == 0)) | not))'

# ===== 4. 作用域：仅 MITM 这些域名 =====
hostname = cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, netflow-mtop.cainiao.com, nbcps-mtop.cainiao.com, community-mtop.cainiao.com, sdk.1rtb.net, adx-cfg-u1.ubixioe.com, ssp.iytcdn.com, cf-gl.qiezibenpao.com, ipip-gl1.qiezibenpao.com
