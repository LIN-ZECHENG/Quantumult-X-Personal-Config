#!name = 菜鸟裹裹 v2
#!author = ?
#!update = 2026-9-7

# ============================================================
#  目标：
#    1. 移除首页头部运营入口，修复功能区残留白底
#    2. 底部导航仅保留 首页 / 我的
#  下发接口：mtop.cainiao.app.e2e.engine.page.fetch
#  命中 pageId：1100（首页）、1300（底部导航）
# ============================================================

# ===== 1. 第三方广告 SDK 域名（直封） =====
host, sdk.1rtb.net, reject
host, adx-cfg-u1.ubixioe.com, reject
host, ssp.iytcdn.com, reject
host, cf-gl.qiezibenpao.com, reject
host, ipip-gl1.qiezibenpao.com, reject

# ===== 2. 菜鸟自研广告/推广接口 =====
^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\..* url reject-dict
^https:\/\/nbcps-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn.* url reject-dict
^https:\/\/community-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguouser\.live\.activity\.trigger\.cn.* url reject-dict

# ===== 3. 移除首页头部运营入口 =====
# 抓包确认：operationList 包含 kingkong（取包裹/寄包裹/物换物/出库码）与 icons 两组，会形成截图中的白底功能区。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.* url jsonjq-response-body 'del(.data.data.data.operationList)'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.* url jsonjq-response-body 'del(.data.data.data.operationList)'

# ===== 4. 移除底部导航中间 3 个按钮 =====
# 抓包确认：2240=首页、2242=发现、2247=寄件券、2248=消息、2249=我的。
^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1300 url jsonjq-response-body '.data.data |= with_entries(select(.key == "2240" or .key == "2249"))'
^https:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\/1\.0.*pageId%22%3A1300 url jsonjq-response-body '.data.data |= with_entries(select(.key == "2240" or .key == "2249"))'

# ===== 5. 作用域：仅 MITM 这些域名 =====
hostname = cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, netflow-mtop.cainiao.com, nbcps-mtop.cainiao.com, community-mtop.cainiao.com, sdk.1rtb.net, adx-cfg-u1.ubixioe.com, ssp.iytcdn.com, cf-gl.qiezibenpao.com, ipip-gl1.qiezibenpao.com
